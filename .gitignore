# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-localhost.log
.next-localhost.*.log

# isolated build outputs used by local and CI verification (see next.config.ts distDir)
.next-*/
.impeccable/

# local audit and generated reports
.sb-pentest-context.json
.sb-pentest-audit.log
.sb-pentest-evidence/
output/
public/auditoria/

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
# .env.example is intentionally tracked

# vercel
.vercel

# A vendored clone of the opencode project, node_modules and all: ~105k files that
# have nothing to do with this app.
#
# `docs`, `scripts` and `resources` used to be listed here too. They are real folders
# of this project, and ignoring them did not remove what was already committed - it
# only made *new* files invisible. The result was a repo where 18 of 27 files under
# docs/ were versioned and the other 9 silently were not, including the deploy runbook
# and the Google Drive setup guide. Anything added there has to be versioned.
opencode

# Local Claude Code state, not shared configuration: settings.local.json holds
# per-machine permissions and worktrees/ holds full checkouts. launch.json and
# skills/ are shared and belong in the repo.
.claude/settings.local.json
.claude/worktrees/


# typescript
*.tsbuildinfo
next-env.d.ts


nul

.vercel
.env*.local

# Docs internos de trabajo (pueden contener credenciales de prueba)
GUIA_PRUEBAS.md
PLAN_MEJORAS.md
SDD-info/
