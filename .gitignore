# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-localhost.log
.next-localhost.*.log

# isolated build outputs used by local and CI verification (see next.config.ts distDir)
.next-*/
.impeccable/

# local audit and generated reports
.sb-pentest-context.json
.sb-pentest-audit.log
.sb-pentest-evidence/
output/
public/auditoria/

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
# .env.example is intentionally tracked

# vercel
.vercel

# irrelevant folders
opencode
.claude/
scripts
docs
resources
!supabase/scripts/
!supabase/scripts/**


# typescript
*.tsbuildinfo
next-env.d.ts


# irrelevant folders
opencode
scripts
docs
resources
!supabase/scripts/
!supabase/scripts/**
!sdd/scripts/
!sdd/scripts/**
# Anchored to the repo root on purpose: the bare `scripts` rule above matches at any
# depth, so an unanchored negation would also un-ignore .agents/scripts and friends.
!/scripts/
/scripts/*
!/scripts/profile-authority/
!/scripts/profile-authority/**

nul

.vercel
.env*.local

# Docs internos de trabajo (pueden contener credenciales de prueba)
GUIA_PRUEBAS.md
PLAN_MEJORAS.md
SDD-info/
